{
  "name": "sk-tocok-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev -H 0.0.0.0",
    "dev:watchdog": "node scripts/watchdog.mjs",
    "build": "node scripts/patch-next.mjs && next build",
    "start": "node --unhandled-rejections=warn node_modules/next/dist/bin/next start",
    "start:host": "node --unhandled-rejections=warn node_modules/next/dist/bin/next start -H 0.0.0.0",
    "lint": "next lint",
    "db:init": "node scripts/init-db.mjs",
    "icons:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-favicons.ps1",
    "images:optimize": "node scripts/optimize-images.mjs",
    "postinstall": "node scripts/patch-next.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neondatabase/serverless": "^1.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/blob": "^2.8.2",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.53.0",
    "googleapis": "^188.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
