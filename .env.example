# ==============================================================================
# SK TOCOK TRANSPARENCY PROGRAM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (NEON POSTGRES - SSL REQUIRED)
# ------------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# ------------------------------------------------------------------------------
# AUTHENTICATION, SESSION COOKIES & WEBHOOK SECRETS
# ------------------------------------------------------------------------------
# Generate strong random 64-byte hex secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
CRON_SECRET=
APPS_SCRIPT_WEBHOOK_SECRET=
# Comma-separated trusted origins for CORS/CSRF (leave blank for same-origin only)
ALLOWED_ORIGINS=
# Canonical public origin for password reset links & OAuth redirects (e.g. https://sk-tocok.vercel.app)
NEXT_PUBLIC_SITE_URL=
# Set TRUST_PROXY=true (or TRUST_CLOUDFLARE=true) ONLY when running self-hosted behind a trusted proxy
TRUST_PROXY=false
TRUST_CLOUDFLARE=false
# Optional initial seed password used ONLY by scripts/init-db.* when users table is empty
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (RESEND - VERIFICATION & PASSWORD RESET)
# ------------------------------------------------------------------------------
# When set, new student accounts must verify their email address before signing in,
# and SK Chairperson password resets are emailed instead of returned in JSON.
RESEND_API_KEY=
EMAIL_FROM="SK Tocok Portal <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# GOOGLE DRIVE CLOUD STORAGE FOR PRINT UPLOADS
# ------------------------------------------------------------------------------
# METHOD 1: Google Apps Script Webhook (set APPS_SCRIPT_WEBHOOK_SECRET & GOOGLE_DRIVE_ROOT_FOLDER_ID in Script Properties)
GOOGLE_APPS_SCRIPT_URL=

# METHOD 2: Google Workspace / Service Account (prefer env vars over JSON file on disk)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Optional subfolder overrides (dynamically resolved/created under GOOGLE_DRIVE_FOLDER_ID when unset)
GOOGLE_DRIVE_PRINTS_FOLDER_ID=
GOOGLE_DRIVE_VOUCHERS_FOLDER_ID=
GOOGLE_DRIVE_DEPOSITS_FOLDER_ID=
GOOGLE_DRIVE_OFFICIALS_FOLDER_ID=
GOOGLE_DRIVE_ATTENDANCE_FOLDER_ID=
GOOGLE_DRIVE_LIMIT_TB=5

# ------------------------------------------------------------------------------
# VERCEL BLOB CLOUD FAILOVER (AUTOMATED SECONDARY BACKUP STORAGE)
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 ("CONTINUE WITH GOOGLE" FOR STUDENT PRINTING LOGIN)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# WEB PUSH NOTIFICATIONS (VAPID KEYS)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
